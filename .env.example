# Token usado pelo coletor football-data.org
FOOTBALL_DATA_TOKEN=

# Gere com: python -m backend.app.auth generate
# Recomendado: armazene somente o hash SHA-256 na VPS.
TRADEFOT_ACCESS_TOKEN_HASH=

# Alternativa simples ao hash (não use os dois ao mesmo tempo):
# TRADEFOT_ACCESS_TOKEN=

# Em produção com HTTPS, impede o envio do cookie por HTTP.
TRADEFOT_COOKIE_SECURE=false

# Opcional; no Docker o valor padrão já é /data
TRADEFOT_DATA_DIR=

# Rede neural: treina modelos ausentes/desatualizados ao iniciar.
TRADEFOT_ML_AUTO_TRAIN=true
TRADEFOT_ML_MIN_MATCHES=500
TRADEFOT_ML_EPOCHS=60

# Opcional; por padrão usa a pasta models dentro de TRADEFOT_DATA_DIR.
# TRADEFOT_MODEL_DIR=

# Porta única do frontend + backend
PORT=8000
